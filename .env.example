# Ollama configuration for /api/explain_tos_scores (shared with lawgic-web-app)
VITE_OLLAMA_BASE_URL=http://localhost:11434

# Primary: cloud-routed, ~1.6 s per clause. Needs internet and a signed-in
# Ollama account on whatever host runs the daemon.
VITE_OLLAMA_MODEL=gemma4:31b-cloud

# Offline fallback: fully local, no network, ~47 s per clause.
# To run offline, comment the line above and uncomment this one.
# VITE_OLLAMA_MODEL=gemma4:e4b
